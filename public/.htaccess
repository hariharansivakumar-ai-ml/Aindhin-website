# ==============================================================================
# Aindhin Production — Apache / LiteSpeed (Hostinger) Configuration
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Follow symbolic links
Options +FollowSymLinks

# Set default directory index
DirectoryIndex index.html

# ── 1. Explicit MIME Types (Crucial for ES Modules & Modern Web Assets) ───────
<IfModule mod_mime.c>
    AddType application/javascript              .js .mjs
    AddType text/css                            .css
    AddType application/json                    .json
    AddType image/svg+xml                       .svg
    AddType image/webp                          .webp
    AddType image/png                           .png
    AddType image/jpeg                          .jpg .jpeg
    AddType image/x-icon                        .ico
    AddType font/woff2                          .woff2
    AddType font/woff                           .woff
    AddType application/manifest+json           .webmanifest
</IfModule>

# ── 2. LiteSpeed Cache (LSCache) Controls for Hostinger ───────────────────────
# Prevents Hostinger's LiteSpeed server cache from serving stale index.html
<IfModule LiteSpeed>
    CacheLookup off
</IfModule>

# ── 3. mod_deflate Compression ────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff
</IfModule>

# ── 4. mod_expires Cache Rules ────────────────────────────────────────────────
# Ensures HTML is revalidated instantly, while hashed assets are cached 1 year
<IfModule mod_expires.c>
    ExpiresActive On

    # Dynamic / HTML entrypoints — NEVER cache
    ExpiresByType text/html                     "access plus 0 seconds"
    ExpiresByType application/json              "access plus 0 seconds"
    ExpiresByType application/xml               "access plus 0 seconds"
    ExpiresByType text/xml                      "access plus 0 seconds"

    # Static hashed assets inside /assets/ — Cache for 1 year (immutable)
    ExpiresByType application/javascript        "access plus 1 year"
    ExpiresByType text/css                      "access plus 1 year"
    ExpiresByType image/webp                    "access plus 1 year"
    ExpiresByType image/png                     "access plus 1 year"
    ExpiresByType image/jpeg                    "access plus 1 year"
    ExpiresByType image/svg+xml                 "access plus 1 year"
    ExpiresByType font/woff2                    "access plus 1 year"
    ExpiresByType font/woff                     "access plus 1 year"
</IfModule>

# ── 5. Cache-Control & Security Headers ───────────────────────────────────────
<IfModule mod_headers.c>
    # Security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"

    # Hashed assets in /assets/ — safe to cache aggressively because filename changes every build
    <FilesMatch "\.(js|css|webp|png|jpg|jpeg|gif|ico|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # CRITICAL: index.html, version.json, and sitemap.xml must NEVER be cached by browser or CDN!
    # If index.html is cached, users will request outdated chunk hashes that no longer exist.
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header set X-LiteSpeed-Cache-Control "no-cache, no-store"
    </FilesMatch>

    <Files "version.json">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header set X-LiteSpeed-Cache-Control "no-cache, no-store"
    </Files>

    <Files "sitemap.xml">
        Header set Cache-Control "no-cache, must-revalidate, max-age=3600"
    </Files>
</IfModule>

# ── 6. HTML5 History API (React Router) & Asset Protection ────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Never rewrite version.json, sitemap.xml, robots.txt
    RewriteRule ^(version\.json|sitemap\.xml|robots\.txt)$ - [L,NC]

    # Never rewrite backend API proxy requests
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^ - [L]

    # CRITICAL: Prevent missing chunk assets from returning index.html!
    # If a JS, CSS, or image file in /assets/ does not exist on disk, return a true 404.
    # If an Apache server rewrites a missing .js file to index.html, the browser receives
    # text/html instead of javascript and crashes with "SyntaxError: Unexpected token '<'".
    RewriteCond %{REQUEST_URI} ^/assets/ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ - [R=404,L]

    # If the requested file or directory exists on disk, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # SPA Fallback: Rewrite all other routes to index.html (page refresh support)
    RewriteRule ^ index.html [L]
</IfModule>
