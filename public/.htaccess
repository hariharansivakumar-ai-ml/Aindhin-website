# Aindhin Production — Cache-Control & SPA Routing
# ─────────────────────────────────────────────────
# Order of rules matters: Apache applies the FIRST matching FilesMatch/Location rule.

# ── version.json — ALWAYS bypass every cache layer ────────────────────────────
# Must come before the generic *.json rule below.
# versionCheck.js fetches this on every chunk error to detect new deployments.
<Files "version.json">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma         "no-cache"
        Header set Expires        "0"
        # Prevent Cloudflare / CDN edge caches from storing this file
        Header set Surrogate-Control "no-store"
    </IfModule>
</Files>

# ── index.html & HTML / JSON — no cache ───────────────────────────────────────
# index.html contains the <script> tags that reference hashed chunk filenames.
# If a browser caches a stale index.html it will request chunks that no longer exist.
<FilesMatch "\.(html|json)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma         "no-cache"
        Header set Expires        "0"
    </IfModule>
</FilesMatch>

# ── Hashed JS / CSS assets — immutable long-term cache ────────────────────────
# ONLY applies to files inside /assets/ which Vite stamps with a content hash.
# The hash changes with every file change, so `immutable` is safe — browsers will
# never request the same URL twice for different content.
SetEnvIf Request_URI "^/assets/.*\.(js|css)$" IS_HASHED_ASSET
<IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=31536000, immutable" env=IS_HASHED_ASSET
</IfModule>

# ── Static media assets — long-term but revalidatable ─────────────────────────
# Images and fonts are also hash-named by Vite so immutable is safe here too.
<FilesMatch "\.(webp|png|jpg|jpeg|gif|ico|svg|woff2?)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=31536000, immutable"
    </IfModule>
</FilesMatch>

# ── HTML5 History API — SPA routing fallback ──────────────────────────────────
# Rewrites all non-file, non-directory requests to /index.html so that React
# Router can handle client-side navigation on direct URL access / page refresh.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase   /

    # Never rewrite version.json — it must be served as a real file
    RewriteRule ^version\.json$ - [L,NC]

    # Never rewrite /api/* proxy requests
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^ - [L]

    # Rewrite everything else that doesn't map to a real file or directory
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
