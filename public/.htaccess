# ==============================================================================
# Aindhin Production — Apache / LiteSpeed (Hostinger) Configuration
# ==============================================================================

# Disable directory browsing
Options -Indexes

# Follow symbolic links
Options +FollowSymLinks

# ── 1. Explicit MIME Types (Crucial for ES Modules & Modern Assets) ───────────
<IfModule mod_mime.c>
    AddType application/javascript              .js .mjs
    AddType text/css                            .css
    AddType application/json                    .json
    AddType image/svg+xml                       .svg
    AddType image/webp                          .webp
    AddType font/woff2                          .woff2
    AddType font/woff                           .woff
    AddType application/manifest+json           .webmanifest
</IfModule>

# ── 2. Enable Gzip / Deflate Compression ──────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# ── 3. LiteSpeed Cache (LSCache) Controls for Hostinger ───────────────────────
<IfModule LiteSpeed>
    CacheLookup off
</IfModule>

# ── 4. Cache-Control & Expiry Headers ─────────────────────────────────────────
<IfModule mod_headers.c>
    # Security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"

    # Environment flag for immutable hashed assets
    SetEnvIf Request_URI "^/assets/.*\.(js|css|webp|png|jpg|jpeg|gif|ico|svg|woff2?)$" IS_HASHED_ASSET

    # Static hashed assets inside /assets/ (immutable 1-year cache)
    Header set Cache-Control "public, max-age=31536000, immutable" env=IS_HASHED_ASSET
</IfModule>

# NEVER cache index.html, version.json, or sitemap.xml
<FilesMatch "^(index\.html|version\.json|sitemap\.xml)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header set Surrogate-Control "no-store"
        Header set X-LiteSpeed-Cache-Control "no-cache, no-store"
    </IfModule>
</FilesMatch>

# ── 5. HTML5 History API Routing & Asset Protection ───────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Never rewrite version.json or sitemap.xml — serve directly
    RewriteRule ^(version\.json|sitemap\.xml|robots\.txt)$ - [L,NC]

    # Never rewrite /api/* requests (API proxy / backend endpoints)
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule ^ - [L]

    # CRITICAL: Prevent missing assets from falling through to index.html!
    # If a JS/CSS/image file in /assets/ does not exist, return a real 404.
    # Returning index.html (text/html) for missing JS breaks dynamic imports and causes syntax errors!
    RewriteCond %{REQUEST_URI} ^/assets/ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ - [R=404,L]

    # Rewrite all valid SPA routes to /index.html (page refresh fallback)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
